+    private static final class QueuedExecutor implements Executor {
+        private final Deque<Runnable> tasks = new ArrayDeque<>();
+        private int submissions;
+        private int maximumQueued;
+        private int rejectAt = -1;
+
+        @Override
+        public void execute(final Runnable operation) {
+            if (++submissions == rejectAt) {
+                throw new RejectedExecutionException("injected rejection");
+            }
+            tasks.addLast(operation);
+            maximumQueued = Math.max(maximumQueued, tasks.size());
+        }
+
+        private void runNext() {
+            tasks.removeFirst().run();
+        }
+
+        private void runAll() {
+            while (!tasks.isEmpty()) {
+                runNext();
+            }
+        }
+    }
