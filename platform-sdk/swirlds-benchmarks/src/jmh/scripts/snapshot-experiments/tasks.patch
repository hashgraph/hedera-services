+    @ParameterizedTest
+    @ValueSource(ints = {0, 3})
+    void externalSubmissionRejectionDrainsAcceptedWriter(final int cursors, @TempDir final Path directory)
+            throws Exception {
+        System.setProperty(CURSORS_PROPERTY, Integer.toString(cursors));
+        final IOException writeFailure = new IOException("accepted writer failed after rejection");
+        final RejectedExecutionException rejection = new RejectedExecutionException("injected external rejection");
+        final CountDownLatch acceptedWriterStarted = new CountDownLatch(1);
+        final CountDownLatch releaseWriter = new CountDownLatch(1);
+        try (final ProbeLongList list = new ProbeLongList();
+                final ForkJoinPool pool = new ExternalRejectionPool(acceptedWriterStarted, rejection)) {
+            list.probe = (_, _) -> {
+                acceptedWriterStarted.countDown();
+                awaitLatch(releaseWriter);
+                throw writeFailure;
+            };
+            final CompletableFuture<Void> snapshot = list.writeToFile(directory.resolve("rejection.ll"), pool);
+            try {
+                assertFalse(snapshot.isDone());
+                assertTrue(list.channel.get().isOpen());
+            } finally {
+                releaseWriter.countDown();
+            }
+            assertSame(rejection, assertThrows(CompletionException.class, snapshot::join).getCause());
+            assertTrue(Arrays.asList(rejection.getSuppressed()).contains(writeFailure));
+            assertEquals(List.of(0), list.startedChunks);
+            assertFalse(list.channel.get().isOpen());
+        }
+    }
