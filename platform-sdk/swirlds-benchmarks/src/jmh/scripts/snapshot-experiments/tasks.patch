+    @Test
+    void presizeIsReadOnEachCallAndPrecedesChunkWrites(@TempDir final Path directory) throws Exception {
+        System.setProperty(CURSORS_PROPERTY, "1");
+        try (final ProbeLongList list = new ProbeLongList();
+                final ForkJoinPool pool = newPool(2)) {
+            list.writeToFile(directory.resolve("off.ll"), pool).get(5, SECONDS);
+            assertEquals(FILE_HEADER_SIZE_V3, list.sizeAtFirstWrite.get());
+
+            System.setProperty(PRESIZE_PROPERTY, "true");
+            list.sizeAtFirstWrite.set(-1);
+            list.channel.set(null);
+            list.writeToFile(directory.resolve("on.ll"), pool).get(5, SECONDS);
+            assertEquals(FILE_HEADER_SIZE_V3 + list.size() * Long.BYTES, list.sizeAtFirstWrite.get());
+            assertFalse(list.channel.get().isOpen());
+        }
+    }
