+class LongListSnapshotExperimentTest extends AbstractFileManagerAwareTest {
+
+    private static final String PRESIZE_PROPERTY = "merkledb.experiment.presizeIndexFiles";
+    private static final String CURSORS_PROPERTY = "merkledb.experiment.cursorsPerList";
