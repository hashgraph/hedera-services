+    private static ForkJoinPool newPool(final int parallelism) {
+        return new ForkJoinPool(parallelism, ForkJoinPool.defaultForkJoinWorkerThreadFactory, null, true);
+    }
+
+    private static void awaitLatch(final CountDownLatch latch) throws IOException {
+        try {
+            if (!latch.await(5, SECONDS)) {
+                throw new IOException("Timed out waiting for test writer release");
+            }
+        } catch (final InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Test writer interrupted", e);
+        }
+    }
+
+    /// Completing the header inline makes cursor roots use external execute(), not worker-local fork().
+    private static final class ExternalRejectionPool extends ForkJoinPool {
+        private final AtomicInteger submissions = new AtomicInteger();
+        private final CountDownLatch acceptedWriterStarted;
+        private final RejectedExecutionException rejection;
+
+        private ExternalRejectionPool(
+                final CountDownLatch acceptedWriterStarted, final RejectedExecutionException rejection) {
+            super(2, ForkJoinPool.defaultForkJoinWorkerThreadFactory, null, true);
+            this.acceptedWriterStarted = acceptedWriterStarted;
+            this.rejection = rejection;
+        }
+
+        @Override
+        public void execute(final ForkJoinTask<?> task) {
+            final int submission = submissions.incrementAndGet();
+            if (submission == 1) {
+                task.invoke();
+            } else if (submission == 3) {
+                throw rejection;
+            } else {
+                super.execute(task);
+                try {
+                    assertTrue(acceptedWriterStarted.await(5, SECONDS));
+                } catch (final InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    throw new AssertionError(e);
+                }
+            }
+        }
+    }
+
+    @FunctionalInterface
+    private interface WriteProbe {
+        void beforeWrite(FileChannel channel, int chunkIndex) throws IOException;
+    }
+
+    private static final class ProbeLongList extends AbstractLongList<long[]> {
+        private final AtomicReference<FileChannel> channel = new AtomicReference<>();
+        private final AtomicLong sizeAtFirstWrite = new AtomicLong(-1);
+        private final List<Integer> startedChunks = new CopyOnWriteArrayList<>();
+        private WriteProbe probe = (_, _) -> {};
+
+        private ProbeLongList() {
+            super(LONGS_PER_CHUNK, CAPACITY, 0);
+            updateValidRange(0, 31);
+            for (int index = 0; index < 32; index++) {
+                put(index, index + 1);
+            }
+        }
+
+        @Override
+        protected void writeChunkData(
+                final FileChannel fileChannel,
+                final long[] chunk,
+                final int startIndexInChunk,
+                final int endIndexInChunk,
+                final long fileOffset)
+                throws IOException {
+            channel.compareAndSet(null, fileChannel);
+            sizeAtFirstWrite.compareAndSet(-1, fileChannel.size());
+            final int chunkIndex = Math.toIntExact((chunk[0] - 1) / longsPerChunk);
+            startedChunks.add(chunkIndex);
+            probe.beforeWrite(fileChannel, chunkIndex);
