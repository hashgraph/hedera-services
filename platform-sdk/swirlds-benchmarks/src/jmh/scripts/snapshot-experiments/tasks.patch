+    @Test
+    void writeFailureDrainsOtherCursorBeforeClosing(@TempDir final Path directory) throws Exception {
+        System.setProperty(CURSORS_PROPERTY, "2");
+        final IOException writeFailure = new IOException("injected writer failure");
+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final CountDownLatch siblingStarted = new CountDownLatch(1);
+        final CountDownLatch failingWriteStopped = new CountDownLatch(1);
+        final CountDownLatch releaseSibling = new CountDownLatch(1);
+        try (final ProbeLongList list = new ProbeLongList();
+                final ForkJoinPool pool = newPool(2)) {
+            list.probe = (_, chunkIndex) -> {
+                if (chunkIndex == 0) {
+                    awaitLatch(siblingStarted);
+                    failingWriteStopped.countDown();
+                    throw writeFailure;
+                }
+                if (chunkIndex == 4) {
+                    siblingStarted.countDown();
+                    awaitLatch(releaseSibling);
+                }
+            };
+            final CompletableFuture<Void> snapshot =
+                    list.writeToFile(directory.resolve("failure.ll"), pool, failure);
+            try {
+                assertTrue(failingWriteStopped.await(5, SECONDS));
+                // The sibling occupies the other worker, so this barrier follows failure recording.
+                pool.submit(() -> {}).get(5, SECONDS);
+                assertSame(writeFailure, failure.get());
+                assertFalse(snapshot.isDone());
+                assertTrue(list.channel.get().isOpen());
+            } finally {
+                releaseSibling.countDown();
+            }
+            assertSame(writeFailure, assertThrows(CompletionException.class, snapshot::join).getCause());
+            assertEquals(Set.of(0, 4), Set.copyOf(list.startedChunks));
+            assertFalse(list.channel.get().isOpen());
+        }
+    }
