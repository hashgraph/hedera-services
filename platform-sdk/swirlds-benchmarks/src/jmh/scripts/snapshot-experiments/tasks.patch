+    @Test
+    void cursorsUseBalancedRunsAndBoundPendingWrites(@TempDir final Path directory) throws Exception {
+        System.setProperty(CURSORS_PROPERTY, "3");
+        final CountDownLatch firstCursorsStarted = new CountDownLatch(3);
+        final CountDownLatch fourthWriteStarted = new CountDownLatch(1);
+        final CountDownLatch releaseWrites = new CountDownLatch(1);
+        try (final ProbeLongList list = new ProbeLongList();
+                final ForkJoinPool pool = newPool(8)) {
+            list.probe = (_, _) -> {
+                if (list.startedChunks.size() > 3) {
+                    fourthWriteStarted.countDown();
+                }
+                firstCursorsStarted.countDown();
+                awaitLatch(releaseWrites);
+            };
+            final CompletableFuture<Void> snapshot = list.writeToFile(directory.resolve("bounded.ll"), pool);
+            try {
+                assertTrue(firstCursorsStarted.await(5, SECONDS));
+                assertFalse(fourthWriteStarted.await(200, MILLISECONDS));
+                assertEquals(Set.of(0, 3, 6), Set.copyOf(list.startedChunks));
+                assertFalse(snapshot.isDone());
+                assertTrue(list.channel.get().isOpen());
+            } finally {
+                releaseWrites.countDown();
+            }
+            snapshot.get(5, SECONDS);
+            assertEquals(8, list.startedChunks.size());
+            assertEquals(
+                    IntStream.range(0, 8).boxed().collect(java.util.stream.Collectors.toSet()),
+                    Set.copyOf(list.startedChunks));
+            assertFalse(list.channel.get().isOpen());
+        }
+    }
