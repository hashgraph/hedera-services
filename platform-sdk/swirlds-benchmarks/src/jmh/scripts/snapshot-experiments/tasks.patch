+    private enum Scenario {
+        EMPTY,
+        RANGE_AFTER_DATA,
+        SPARSE_PARTIAL,
+        SINGLE_CHUNK
+    }
+
+    static Stream<Arguments> roundTripCases() {
+        return Arrays.stream(LongListImplementation.values())
+                .flatMap(implementation -> Stream.of(false, true)
+                        .flatMap(presize -> IntStream.of(0, 3, 8)
+                                .boxed()
+                                .flatMap(cursors -> Arrays.stream(Scenario.values())
+                                        .map(scenario -> Arguments.of(implementation, presize, cursors, scenario)))));
+    }
+
+    @ParameterizedTest
+    @MethodSource("roundTripCases")
+    void roundTripWithExperimentSwitches(
+            final LongListImplementation implementation,
+            final boolean presize,
+            final int cursors,
+            final Scenario scenario,
+            @TempDir final Path directory)
+            throws Exception {
+        System.setProperty(PRESIZE_PROPERTY, Boolean.toString(presize));
+        System.setProperty(CURSORS_PROPERTY, Integer.toString(cursors));
+        final MerkleDbConfig config = ConfigurationBuilder.create()
+                .autoDiscoverExtensions()
+                .withValue(MerkleDbConfig_.LONG_LIST_CHUNK_SIZE, Integer.toString(LONGS_PER_CHUNK))
+                .withValue(MerkleDbConfig_.LONG_LIST_RESERVED_BUFFER_SIZE, "1")
+                .build()
+                .getConfigData(MerkleDbConfig.class);
+        final Path file = directory.resolve("index.ll");
+        try (final LongList list = implementation.create(CAPACITY, config, fileSystemManager);
+                final ForkJoinPool pool = newPool(4)) {
+            switch (scenario) {
+                case EMPTY -> {}
+                case RANGE_AFTER_DATA -> {
+                    list.updateValidRange(0, CAPACITY - 1);
+                    list.put(2, 123);
+                    list.updateValidRange(20, CAPACITY - 1);
+                }
+                case SPARSE_PARTIAL -> {
+                    list.updateValidRange(2, 26);
+                    list.put(2, 123);
+                    list.put(4, 456);
+                    list.put(5, 789);
+                    list.put(26, 987);
+                }
+                case SINGLE_CHUNK -> {
+                    list.updateValidRange(1, 2);
+                    list.put(2, 123);
+                }
+            }
+            list.writeToFile(file, pool).get(5, SECONDS);
+            final long bodyLongs = list.size() > 0 && list.getMinValidIndex() < list.size()
+                    ? list.size() - list.getMinValidIndex()
+                    : 0;
+            assertEquals(FILE_HEADER_SIZE_V3 + bodyLongs * Long.BYTES, Files.size(file));
+            try (final LongList loaded = implementation.load(file, CAPACITY, config, fileSystemManager)) {
+                assertEquals(bodyLongs == 0 ? 0 : list.size(), loaded.size());
+                for (long index = 0; index < CAPACITY; index++) {
+                    assertEquals(list.get(index, 0), loaded.get(index, 0), "Index " + index);
+                }
+            }
+        }
+    }
